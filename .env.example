# 임시 계정 로그인. 외부 공개 전 false로 바꾸고 계정 비밀번호도 변경하세요.
DEMO_AUTH_ENABLED=true
SEED_PASSWORD=1234
# 새 JSON 파일이 생성될 때만 SEED_PASSWORD가 적용됩니다.
JSON_DB_FILE=./data/db.json
# PostgreSQL 접속 URL을 넣으면 JSON 대신 DB를 사용합니다. 비워두면 기존 JSON 모드입니다.
# 로컬 개발: Render 외부 URL / Render 서버: 같은 리전의 내부 URL
DATABASE_URL=
DATABASE_SSL=auto
# 자체 CA가 필요한 DB에서만 사용합니다. TLS 인증서 검증을 끄지 않습니다.
DATABASE_CA_CERT=
APP_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false

# 카카오디벨로퍼스 앱의 REST API 키 및 등록된 콜백 주소
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:3000/api/auth/kakao/callback

# AI 게시글 보정. 서버 전용 키이며 NEXT_PUBLIC_ 접두사를 사용하지 않습니다.
OPENAI_API_KEY=
OPENAI_POLISH_MODEL=gpt-4.1-mini
